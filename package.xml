<?xml version="1.0"?>
<package format="3">
  <name>mrc</name>
  <version>0.0.1</version>
  <description>Multi-robot calibration via point cloud registration (KISS-Matcher / FRICP), master publishes static TF.</description>

  <maintainer email="user@placeholder.local">Maintainer</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>rosidl_default_generators</build_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_ros</depend>
  <depend>rclcpp_action</depend>
  <depend>visualization_msgs</depend>
  <depend>action_msgs</depend>
  <depend>pcl_conversions</depend>

  <!-- Robot announcements come from this installed package -->
  <depend>hector_multi_robot_msgs</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <!-- Required because this package installs ROS interfaces (.msg/.srv) -->
  <member_of_group>rosidl_interface_packages</member_of_group>
</package>