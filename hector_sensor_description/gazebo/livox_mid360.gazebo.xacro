<?xml version="1.0"?>

<robot xmlns:xacro="http://ros.org/wiki/xacro">
	<xacro:property name="M_PI" value="3.14159"/>

	<!-- RGL-based Livox Mid360 sensor using actual non-repetitive scan pattern -->
	<xacro:macro name="livox_mid360_gazebo" params="visualize:=True name:=default">
		<gazebo reference="${name}_laser_frame">
			<!-- RGL custom sensor for realistic Livox Mid360 scan pattern -->
			<sensor name="rgl_lidar_${name}" type="custom">
				<plugin filename="RGLServerPluginInstance" name="rgl::RGLServerPluginInstance">
					<!-- Range limits (Livox Mid360 specs: 0.1m - 70m) -->
					<range>
						<min>0.1</min>
						<max>70</max>
					</range>

					<!-- Update rate: 10 Hz (matches original config) -->
					<update_rate>10</update_rate>

					<!--
					  Gazebo topic for point cloud.
					  Include robot namespace so bridge can find it.
					  Publishes to /ec_swift_1/front_lidar/points in Gazebo.
					-->
					<topic>/$(arg robot_name)/${name}/points</topic>

					<!-- TF frame ID -->
					<frame>${name}_laser_frame</frame>

					<!-- Use actual Livox Mid360 scan pattern from RGL patterns library -->
					<!-- This provides the realistic non-repetitive flower pattern -->
					<pattern_preset>Livox Mid360</pattern_preset>

					<!-- Continue publishing when sim is paused -->
					<update_on_paused_sim>false</update_on_paused_sim>
				</plugin>
			</sensor>
		</gazebo>
	</xacro:macro>
</robot>
