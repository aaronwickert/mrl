<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="mrc_test_world">

    <!-- Physics -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- Required plugins -->
    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin name="gz::sim::systems::Imu" filename="gz-sim-imu-system"/>
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system"/>

    <!-- RGL LiDAR Manager Plugin -->
    <plugin name="rgl::RGLServerPluginManager" filename="RGLServerPluginManager">
      <do_ignore_entities_in_lidar_link>true</do_ignore_entities_in_lidar_link>
    </plugin>

    <!-- Lighting -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Room walls (8m x 8m room) -->
    <!-- Wall North -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 4 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>8 0.2 2.5</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>8 0.2 2.5</size></box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
            <laser_retro>1.0</laser_retro>
          </material>
        </visual>
      </link>
    </model>

    <!-- Wall South -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -4 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>8 0.2 2.5</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>8 0.2 2.5</size></box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
            <laser_retro>1.0</laser_retro>
          </material>
        </visual>
      </link>
    </model>

    <!-- Wall East -->
    <model name="wall_east">
      <static>true</static>
      <pose>4 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.2 8 2.5</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.2 8 2.5</size></box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
            <laser_retro>1.0</laser_retro>
          </material>
        </visual>
      </link>
    </model>

    <!-- Wall West -->
    <model name="wall_west">
      <static>true</static>
      <pose>-4 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.2 8 2.5</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.2 8 2.5</size></box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
            <laser_retro>1.0</laser_retro>
          </material>
        </visual>
      </link>
    </model>

    <!-- Table -->
    <model name="table">
      <static>true</static>
      <pose>2 2 0.4 0 0 0</pose>
      <link name="link">
        <!-- Table top -->
        <collision name="top_collision">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <box><size>1.2 0.8 0.05</size></box>
          </geometry>
        </collision>
        <visual name="top_visual">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <box><size>1.2 0.8 0.05</size></box>
          </geometry>
          <material>
            <ambient>0.5 0.3 0.1 1</ambient>
            <diffuse>0.6 0.4 0.2 1</diffuse>
            <laser_retro>0.8</laser_retro>
          </material>
        </visual>
        <!-- Leg 1 -->
        <collision name="leg1_collision">
          <pose>0.5 0.3 -0.2 0 0 0</pose>
          <geometry>
            <cylinder><radius>0.03</radius><length>0.4</length></cylinder>
          </geometry>
        </collision>
        <visual name="leg1_visual">
          <pose>0.5 0.3 -0.2 0 0 0</pose>
          <geometry>
            <cylinder><radius>0.03</radius><length>0.4</length></cylinder>
          </geometry>
          <material>
            <ambient>0.3 0.2 0.1 1</ambient>
            <diffuse>0.4 0.3 0.2 1</diffuse>
          </material>
        </visual>
        <!-- Leg 2 -->
        <collision name="leg2_collision">
          <pose>-0.5 0.3 -0.2 0 0 0</pose>
          <geometry>
            <cylinder><radius>0.03</radius><length>0.4</length></cylinder>
          </geometry>
        </collision>
        <visual name="leg2_visual">
          <pose>-0.5 0.3 -0.2 0 0 0</pose>
          <geometry>
            <cylinder><radius>0.03</radius><length>0.4</length></cylinder>
          </geometry>
          <material>
            <ambient>0.3 0.2 0.1 1</ambient>
            <diffuse>0.4 0.3 0.2 1</diffuse>
          </material>
        </visual>
        <!-- Leg 3 -->
        <collision name="leg3_collision">
          <pose>0.5 -0.3 -0.2 0 0 0</pose>
          <geometry>
            <cylinder><radius>0.03</radius><length>0.4</length></cylinder>
          </geometry>
        </collision>
        <visual name="leg3_visual">
          <pose>0.5 -0.3 -0.2 0 0 0</pose>
          <geometry>
            <cylinder><radius>0.03</radius><length>0.4</length></cylinder>
          </geometry>
          <material>
            <ambient>0.3 0.2 0.1 1</ambient>
            <diffuse>0.4 0.3 0.2 1</diffuse>
          </material>
        </visual>
        <!-- Leg 4 -->
        <collision name="leg4_collision">
          <pose>-0.5 -0.3 -0.2 0 0 0</pose>
          <geometry>
            <cylinder><radius>0.03</radius><length>0.4</length></cylinder>
          </geometry>
        </collision>
        <visual name="leg4_visual">
          <pose>-0.5 -0.3 -0.2 0 0 0</pose>
          <geometry>
            <cylinder><radius>0.03</radius><length>0.4</length></cylinder>
          </geometry>
          <material>
            <ambient>0.3 0.2 0.1 1</ambient>
            <diffuse>0.4 0.3 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Chair -->
    <model name="chair">
      <static>true</static>
      <pose>2 1.2 0 0 0 0</pose>
      <link name="link">
        <!-- Seat -->
        <collision name="seat_collision">
          <pose>0 0 0.45 0 0 0</pose>
          <geometry>
            <box><size>0.45 0.45 0.05</size></box>
          </geometry>
        </collision>
        <visual name="seat_visual">
          <pose>0 0 0.45 0 0 0</pose>
          <geometry>
            <box><size>0.45 0.45 0.05</size></box>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.5 1</ambient>
            <diffuse>0.3 0.3 0.7 1</diffuse>
            <laser_retro>0.6</laser_retro>
          </material>
        </visual>
        <!-- Backrest -->
        <collision name="back_collision">
          <pose>0 -0.2 0.7 0 0 0</pose>
          <geometry>
            <box><size>0.45 0.05 0.5</size></box>
          </geometry>
        </collision>
        <visual name="back_visual">
          <pose>0 -0.2 0.7 0 0 0</pose>
          <geometry>
            <box><size>0.45 0.05 0.5</size></box>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.5 1</ambient>
            <diffuse>0.3 0.3 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Bookshelf -->
    <model name="bookshelf">
      <static>true</static>
      <pose>-2.5 3 0.9 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>1.5 0.4 1.8</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>1.5 0.4 1.8</size></box>
          </geometry>
          <material>
            <ambient>0.4 0.25 0.1 1</ambient>
            <diffuse>0.5 0.35 0.2 1</diffuse>
            <laser_retro>0.9</laser_retro>
          </material>
        </visual>
      </link>
    </model>

    <!-- Cylinder obstacle (like a trash can) -->
    <model name="trash_can">
      <static>true</static>
      <pose>-1 -2 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder><radius>0.2</radius><length>0.7</length></cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder><radius>0.2</radius><length>0.7</length></cylinder>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
            <laser_retro>1.2</laser_retro>
          </material>
        </visual>
      </link>
    </model>

    <!-- Box (like a crate) -->
    <model name="crate">
      <static>true</static>
      <pose>1 -2.5 0.3 0 0 0.3</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.6 0.6 0.6</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.6 0.6 0.6</size></box>
          </geometry>
          <material>
            <ambient>0.6 0.5 0.3 1</ambient>
            <diffuse>0.7 0.6 0.4 1</diffuse>
            <laser_retro>0.7</laser_retro>
          </material>
        </visual>
      </link>
    </model>

    <!-- Sphere (like a ball) -->
    <model name="ball">
      <static>true</static>
      <pose>2.5 -1 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <sphere><radius>0.15</radius></sphere>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <sphere><radius>0.15</radius></sphere>
          </geometry>
          <material>
            <ambient>0.8 0.2 0.2 1</ambient>
            <diffuse>1.0 0.3 0.3 1</diffuse>
            <laser_retro>0.5</laser_retro>
          </material>
        </visual>
      </link>
    </model>

    <!-- Plant pot -->
    <model name="plant_pot">
      <static>true</static>
      <pose>-3 -1 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder><radius>0.15</radius><length>0.5</length></cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder><radius>0.15</radius><length>0.5</length></cylinder>
          </geometry>
          <material>
            <ambient>0.4 0.25 0.1 1</ambient>
            <diffuse>0.5 0.3 0.15 1</diffuse>
            <laser_retro>0.8</laser_retro>
          </material>
        </visual>
      </link>
    </model>

    <!-- Pillar -->
    <model name="pillar">
      <static>true</static>
      <pose>-2 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.3 0.3 2.5</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.3 0.3 2.5</size></box>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <laser_retro>1.0</laser_retro>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
